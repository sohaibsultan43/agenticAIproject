# ScholarSync Environment Configuration
# =====================================

# Google AI Studio API Key (Required)
# Get your key from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Weaviate Cloud Configuration (Required)
# Get your credentials from: https://console.weaviate.cloud/
# 1. Create a free cluster at https://console.weaviate.cloud/
# 2. Copy the cluster URL (e.g., https://your-cluster-name.weaviate.network)
# 3. Create an API key in the cluster dashboard
WEAVIATE_CLOUD_URL=https://your-cluster-name.weaviate.network
WEAVIATE_API_KEY=your_weaviate_api_key_here

# Application Settings (Optional)
DOWNLOAD_DIR=./downloaded_papers
MAX_PAPERS_PER_SEARCH=10

# LlamaParse Configuration (Optional - for better equation/table parsing)
# Get your key from: https://cloud.llamaindex.ai/
LLAMA_CLOUD_API_KEY=your_llama_cloud_api_key_here
